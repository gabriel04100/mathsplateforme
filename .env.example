# Copier en .env (ou définir dans l'hébergeur). Toutes les valeurs sont facultatives.
NODE_ENV=production
PORT=3000

# Fichier de base de données SQLite
DB_FILE=./data/plateforme.sqlite

# Compte enseignant créé automatiquement au PREMIER démarrage s'il n'en existe aucun
TEACHER_USERNAME=gpizzo
TEACHER_PASSWORD=changez-moi-tout-de-suite
TEACHER_NAME=Gabriel Pizzo

# Durée de validité d'une connexion (jours)
SESSION_TTL_DAYS=30
# Tentatives de connexion autorisées par élève et par 15 minutes
LOGIN_MAX_ATTEMPTS=10

# Traduction automatique du contenu (élèves allophones).
# Laisser vide = fonction désactivée : le bouton 🌐 annonce qu'elle n'est pas disponible.
# Le navigateur de l'élève n'appelle jamais le traducteur : c'est le serveur qui le fait.
#   libretranslate : logiciel libre, auto-hébergeable (TRANSLATE_URL obligatoire)
#   google         : API Cloud Translation v2, facturée (TRANSLATE_KEY obligatoire)
TRANSLATE_PROVIDER=
TRANSLATE_URL=
TRANSLATE_KEY=
